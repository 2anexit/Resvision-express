rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /publicShares/{shareId} {
      allow get: if resource.data.public == true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.public == true
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.series is list
        && request.resource.data.series.size() > 0
        && request.resource.data.series.size() <= 30;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
