<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1E8"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAlignment="center"
            android:textColor="#1F2937"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/menu_subtitle"
            android:textColor="#6B7280"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/menuContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_title"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/watchModeButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="56dp"
                android:text="@string/watch_mode_off"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/watchModeStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/watch_mode_status_off"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mathsButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="56dp"
                android:text="@string/category_maths"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/francaisButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/category_francais"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/anglaisButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/category_anglais"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/physiqueChimieButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/category_physique_chimie"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/histoireGeographieButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/category_histoire_geographie"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toutMelangeButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/category_tout_melange"
                android:textAllCaps="false" />

            <LinearLayout
                android:id="@+id/customCategoriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createMoreButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="56dp"
                android:text="Créer plus"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mySeriesButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="56dp"
                android:text="Mes séries"
                android:textAllCaps="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/subcategoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/subcategoryTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Choisis une sous-categorie" />

            <LinearLayout
                android:id="@+id/subcategoryButtonsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToCategoriesButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/back_to_categories"
                android:textAllCaps="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/quizContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/categoryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#7C3AED"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Categorie : Maths" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progressTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Question 1 / 20" />

                <TextView
                    android:id="@+id/timerTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="10:00" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/soundToggleButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="48dp"
                android:text="@string/sound_on"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/inputModeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#6B7280"
                android:textSize="14sp"
                tools:text="Reponds sur le telephone." />

            <TextView
                android:id="@+id/questionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFDF8"
                android:lineSpacingExtra="4dp"
                android:padding="20dp"
                android:textColor="#111827"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Quelle est la capitale de la France ?" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optionButton1"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:padding="14dp"
                android:textAllCaps="false"
                tools:text="Paris" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optionButton2"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:padding="14dp"
                android:textAllCaps="false"
                tools:text="Rome" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optionButton3"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:padding="14dp"
                android:textAllCaps="false"
                tools:text="Madrid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/optionButton4"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:padding="14dp"
                android:textAllCaps="false"
                tools:text="Berlin" />

            <TextView
                android:id="@+id/feedbackTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:minHeight="28dp"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Bonne reponse !" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="56dp"
                android:text="@string/submit_answer"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/abandonQuizButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/abandon_quiz"
                android:textAllCaps="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#FFFDF8"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/resultTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/result_title"
                android:textColor="#111827"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultCategoryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#6B7280"
                android:textSize="16sp"
                tools:text="Categorie : Maths" />

            <TextView
                android:id="@+id/scoreTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="#16A34A"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="Score : 42 / 50" />

            <TextView
                android:id="@+id/scoreMessageTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="#374151"
                android:textSize="16sp"
                tools:text="Excellent niveau. Continue comme ca." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="56dp"
                android:text="@string/retry_category"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToMenuButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="@string/back_to_menu"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
